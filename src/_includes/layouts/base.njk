{% set pageTitle = title or site.title %}
{% set pageDescription = description or site.description %}
{% set canonical = meta.url + (page.url | url) %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<meta name="author" content="{{ site.fullName }}">
<meta name="theme-color" content="#2b7bc0">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.fullName }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ meta.url }}{{ '/assets/og.png' | url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ meta.url }}{{ '/assets/og.png' | url }}">
<link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": site.fullName,
  "url": meta.url + ('/' | url),
  "email": "mailto:" + site.email,
  "jobTitle": "M.S. in Financial Economics candidate",
  "affiliation": { "@type": "CollegeOrUniversity", "name": "Columbia Business School" },
  "address": { "@type": "PostalAddress", "addressLocality": site.location },
  "sameAs": [site.linkedin, site.github]
} | dump | safe }}</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main"{% if mainClass %} class="{{ mainClass }}"{% endif %}>
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="{{ '/js/main.js' | url }}"></script>
</body>
</html>
